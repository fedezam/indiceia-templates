{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://indiceia.com/schemas/template.metadata.schema.json",
  "title": "IndiceIA Template Metadata",
  "type": "object",
  "required": [
    "name",
    "version",
    "tier",
    "description",
    "ideal_for",
    "supports",
    "visual"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tier": {
      "type": "string",
      "enum": [
        "C1",
        "C2",
        "C3",
        "S1",
        "S2",
        "S3"
      ]
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "experimental"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "ideal_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "supports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_source": {
      "type": "string"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "visual": {
      "type": "object",
      "properties": {
        "iframe_url": {
          "type": "string"
        },
        "preview_html": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        }
      }
    },
    "previews": {
      "type": "object",
      "properties": {
        "html": {
          "type": "string"
        },
        "component": {
          "type": "string"
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "readme": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
